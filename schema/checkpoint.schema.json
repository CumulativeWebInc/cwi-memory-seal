{"$id":"https://cumulativewebinc.github.io/cwi-memory-seal/schema/checkpoint.schema.json","$schema":"http://json-schema.org/draft-07/schema#","definitions":{"checkpoint":{"properties":{"checkpoint_id":{"pattern":"^msc_[0-9A-HJKMNP-TV-Z]{16}$","type":"string"},"created_at":{"format":"date-time","type":"string"},"entries_hash":{"pattern":"^[0-9a-f]{64}$","type":"string"},"entry_count":{"minimum":1,"type":"integer"},"label":{"type":"string"},"prev_hash":{"pattern":"^([0-9a-f]{64})?$","type":["string","null"]},"schema":{"const":"cwi.memory-checkpoint/1.0"},"signature_b64":{"type":"string"},"signer_pubkey_b64":{"type":"string"}},"required":["schema","checkpoint_id","created_at","entries_hash","entry_count","prev_hash","signer_pubkey_b64","signature_b64"],"type":"object"},"entry":{"properties":{"id":{"type":"string"},"text":{"type":"string"},"ts":{"type":["string","null"]}},"required":["id","text"],"type":"object"}},"description":"A checkpoint seals a snapshot of memory entries with a SHA-256 entries hash and an Ed25519 signature. It proves entries were not added/removed/edited/reordered since sealing — it says nothing about whether they were true when sealed.","oneOf":[{"$ref":"#/definitions/checkpoint"},{"properties":{"checkpoints":{"items":{"$ref":"#/definitions/checkpoint"},"type":"array"},"schema":{"const":"cwi.memory-checkpoint-log/1.0"}},"required":["schema","checkpoints"],"type":"object"}],"title":"CWI Memory Checkpoint (cwi.memory-checkpoint/1.0) + log (cwi.memory-checkpoint-log/1.0)"}