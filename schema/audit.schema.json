{"$id":"https://cumulativewebinc.github.io/cwi-memory-seal/schema/audit.schema.json","$schema":"http://json-schema.org/draft-07/schema#","description":"Result of a Memory Seal contamination scan over memory text. Findings are heuristic triage input — never verdicts. A clean scan is not a proof of clean memory.","properties":{"audit_id":{"pattern":"^msa_[0-9A-HJKMNP-TV-Z]{16}$","type":"string"},"counts":{"properties":{"CRITICAL":{"minimum":0,"type":"integer"},"INFO":{"minimum":0,"type":"integer"},"WARNING":{"minimum":0,"type":"integer"}},"required":["CRITICAL","WARNING","INFO"],"type":"object"},"finding_count":{"minimum":0,"type":"integer"},"findings":{"items":{"properties":{"advice":{"type":"string"},"evidence":{"description":"Exact excerpt that triggered the rule","type":"string"},"line":{"minimum":0,"type":"integer"},"line2":{"type":["integer","null"]},"rule":{"pattern":"^MS-\\d{2}$","type":"string"},"severity":{"enum":["CRITICAL","WARNING","INFO"]},"title":{"type":"string"}},"required":["rule","severity","title","line","evidence","advice"],"type":"object"},"type":"array"},"honest_limits":{"type":"string"},"input_sha256":{"description":"sha256 of the canonicalized scanned text","pattern":"^[0-9a-f]{64}$","type":"string"},"line_count":{"minimum":0,"type":"integer"},"rules_version":{"const":"ms-rules/1.0","type":"string"},"scanned_at":{"format":"date-time","type":"string"},"schema":{"const":"cwi.memory-audit/1.0"},"source":{"description":"Human label for the scanned input","type":"string"}},"required":["schema","audit_id","source","scanned_at","rules_version","input_sha256","line_count","counts","finding_count","findings"],"title":"CWI Memory Audit (cwi.memory-audit/1.0)","type":"object"}